datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. ระบบคำร้องขอหนังสือรับรอง
// -------------------------------------------------------------
model CertificateType {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  name        String               @db.VarChar(255) // เช่น หนังสือรับรองการเป็นนิสิต, หนังสือรับรองความประพฤติ
  description String?              @db.Text
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  requests    CertificateRequest[]

  @@map("certificate_types")
}

model CertificateRequest {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  certificateTypeId String          @map("certificate_type_id") @db.Uuid
  status            String          @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reason            String?         @db.Text // เหตุผลกรณีปฏิเสธ
  note              String?         @db.Text // วัตถุประสงค์การขอ
  issuedDocumentUrl String?         @map("issued_document_url") @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  certificateType   CertificateType @relation(fields: [certificateTypeId], references: [id], onDelete: Cascade)

  @@map("certificate_requests")
}

// -------------------------------------------------------------
// 2. ระบบจองห้องประชุมออนไลน์
// -------------------------------------------------------------
model MeetingRoom {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String           @db.VarChar(255)
  capacity  Int              @default(10)
  equipment String?          @db.Text // อุปกรณ์ประจำห้อง เช่น โปรเจกเตอร์, ไมค์
  imageUrl  String?          @map("image_url") @db.VarChar(500)
  isActive  Boolean          @default(true) @map("is_active")
  bookings  MeetingBooking[]

  @@map("meeting_rooms")
}

model MeetingBooking {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  roomId      String      @map("room_id") @db.Uuid
  requesterId String      @map("requester_id") @db.Uuid
  title       String      @db.VarChar(255) // หัวข้อการประชุม
  startTime   DateTime    @map("start_time") @db.Timestamptz()
  endTime     DateTime    @map("end_time") @db.Timestamptz()
  status      String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  remark      String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  room        MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("meeting_bookings")
}

// -------------------------------------------------------------
// 3. ทะเบียนนิสิต (Student Directory & Records)
// -------------------------------------------------------------
model Student {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  studentCode String             @map("student_code") @db.VarChar(50) // รหัสนิสิต
  title       String?            @db.VarChar(50) // พระ, สามเณร, นาย, นางสาว
  firstName   String             @map("first_name") @db.VarChar(100)
  lastName    String             @map("last_name") @db.VarChar(100)
  yearLevel   Int                @default(1) @map("year_level") // ชั้นปี 1-4
  degree      String?            @default("ปริญญาตรี") @db.VarChar(100)
  faculty     String?            @default("คณะพุทธศาสตร์") @db.VarChar(255)
  department  String?            @db.VarChar(255) // ภาควิชา
  major       String?            @db.VarChar(255) // สาขาวิชา
  studyStatus String?            @default("ปกติ") @map("study_status") @db.VarChar(50)
  email       String?            @db.VarChar(255)
  phoneNumber String?            @map("phone_number") @db.VarChar(50)
  isActive    Boolean            @default(true) @map("is_active")
  enrollments CourseEnrollment[]

  @@unique([tenantId, studentCode])
  @@map("students")
}

// -------------------------------------------------------------
// 4. รายวิชา, ตารางสอน, และการลงทะเบียน
// -------------------------------------------------------------
model Course {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  courseCode       String              @map("course_code") @db.VarChar(50) // รหัสวิชา
  courseName       String              @map("course_name") @db.VarChar(255)
  courseNameEn     String?             @map("course_name_en") @db.VarChar(255)
  credits          Int                 @default(3)
  section          String              @default("1") @db.VarChar(20)
  term             String              @db.VarChar(50) // เช่น 1/2569
  academicYear     String              @default("2569") @map("academic_year") @db.VarChar(20)
  semester         Int                 @default(1)
  room             String?             @db.VarChar(100) // ห้องเรียน
  dayOfWeek        Int?                @map("day_of_week") // 1=จันทร์ .. 7=อาทิตย์
  startTime        String?             @map("start_time") @db.VarChar(20)
  endTime          String?             @map("end_time") @db.VarChar(20)
  targetSessions   Int                 @default(16) @map("target_sessions") // จำนวนคาบทั้งหมด
  calculationRules Json                @default("{\"lateCountsAsFull\": true, \"minPercent\": 80.0}") @map("calculation_rules")
  enrollments      CourseEnrollment[]
  sessions         AttendanceSession[]

  @@map("courses")
}

model CourseEnrollment {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  courseId        String             @map("course_id") @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  attendanceScore Float?             @map("attendance_score")
  status          String             @default("ENROLLED")
  records         AttendanceRecord[]

  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("course_enrollments")
}

// -------------------------------------------------------------
// 5. ระบบเช็คชื่อและสิทธิ์สอบ 80%
// -------------------------------------------------------------
model AttendanceSession {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  courseId  String             @map("course_id") @db.Uuid
  sessionNo Int                @map("session_no") // คาบที่ 1-16
  date      DateTime           @db.Date
  qrCode    String?            @map("qr_code") @db.VarChar(100) // Dynamic timed QR
  records   AttendanceRecord[]

  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  sessionId    String            @map("session_id") @db.Uuid
  enrollmentId String            @map("enrollment_id") @db.Uuid
  status       String            @default("PRESENT") // PRESENT (มา), LATE (สาย), LEAVE (ลา), ABSENT (ขาด)
  markedAt     DateTime          @default(now()) @map("marked_at") @db.Timestamptz()

  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment   CourseEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

// -------------------------------------------------------------
// 6. กิจกรรมมหาวิทยาลัยและการอบรมวิปัสสนากรรมฐาน
// -------------------------------------------------------------
model Event {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  title            String              @db.VarChar(255)
  startDate        DateTime            @map("start_date") @db.Timestamptz()
  endDate          DateTime            @map("end_date") @db.Timestamptz()
  activityHours    Int                 @default(3) @map("activity_hours") // ชั่วโมงกิจกรรม
  meditationConfig Json?               @map("meditation_config") // การตั้งค่ากลุ่มวิปัสสนา
  registrations    EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  participantName String    @map("participant_name") @db.VarChar(255)
  groupNumber     Int?      @map("group_number") // กลุ่มที่
  groupName       String?   @map("group_name") @db.VarChar(100)
  attendedAt      DateTime? @map("attended_at") @db.Timestamptz()
  dailyAttendance Json?     @map("daily_attendance") // เช็คชื่อรายวัน

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_registrations")
}
