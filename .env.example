# =============================================================================
# Google Sheets Integration Configuration (Database หลักถาวรบน Vercel Production)
# 1. สร้าง Service Account จาก Google Cloud Console (IAM & Admin -> Service Accounts)
# 2. นำ Service Account Email ไปกดแชร์สิทธิ์ Editor ใน Google Spreadsheet ของคุณ
# 3. นำ Sheet ID (ดูจาก URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit) มาใส่ที่นี่
# =============================================================================
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# คัดลอก private key ทั้งหมดรวมถึง -----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY=

# =============================================================================
# Session Security & Encryption (บังคับบน Production)
# สุ่มคีย์ความยาว >= 32 ตัวอักษร ด้วยคำสั่ง:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
AUTH_SECRET=

# =============================================================================
# Application Domain & Host Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL="https://ne-ser-fb.vercel.app"
NEXT_PUBLIC_APP_NAME="ระบบบริการนิสิตและวิชาการ (Google Sheets Edition)"
PORT=3020

# =============================================================================
# Google OAuth 2.0 (ทางเลือก - สำหรับปุ่มเข้าสู่ระบบด้วย Google MCU Account)
# =============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =============================================================================
# SMTP Mailer (ทางเลือก - สำหรับการส่งอีเมลตั้งรหัสผ่านใหม่ให้อาจารย์)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@mcu.ac.th"

# =============================================================================
# LINE Notify / Webhook (ทางเลือก - สำหรับการแจ้งเตือนสถานะคำร้องและกิจกรรม)
# =============================================================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=

