# Google Sheets Integration Configuration
# 1. สร้าง Service Account จาก Google Cloud Console (IAM & Admin -> Service Accounts)
# 2. นำ Service Account Email ไปกดแชร์สิทธิ์ Editor ใน Google Spreadsheet ของคุณ
# 3. นำ Sheet ID (ดูจาก URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit) มาใส่ที่นี่

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# คัดลอก private key ทั้งหมดรวมถึง -----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY=

# Application Port (default: 3020 เพื่อไม่ให้ชนกับระบบเดิม port 3010)
PORT=3020
NEXT_PUBLIC_APP_NAME="ระบบบริการนิสิตและวิชาการ (Google Sheets Edition)"
