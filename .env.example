# ==========================================
# DIGITAL UNIVERSITY HUB - ENVIRONMENT CONFIG
# ==========================================

# Data Source Mode: 'HYBRID' (Postgres + auto-sync to Sheets), 'POSTGRES' (DB only), or 'SHEETS' (100% Sheets API)
DATA_SOURCE_MODE=HYBRID

# PostgreSQL Connection String (Neon, Supabase, Vercel Postgres, or Local)
DATABASE_URL="postgresql://user:password@localhost:5432/university_db?schema=public"

# Multi-Tenancy Default
DEFAULT_TENANT_ID="default"
DEFAULT_TENANT_CODE="UNIV-MAIN"

# Google Sheets API (v4) Configuration
# Option A: In-line JSON Service Account (Ideal for Vercel Environment Variables)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to Service Account JSON credentials file (for local dev)
# GOOGLE_APPLICATION_CREDENTIALS="./credentials.json"

# Master Spreadsheet ID (from URL https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# App URL for Verification QR Code generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"
